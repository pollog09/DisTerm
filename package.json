{
  "name": "node-terminal",
  "version": "0.4.11",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "description": "Your terminals and agents on an infinite canvas.",
  "author": {
    "name": "Distriib",
    "email": "support@distriib.com",
    "url": "https://distriib.com"
  },
  "homepage": "https://distriib.com",
  "license": "BUSL-1.1",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run host:build && npm run build:codex-relay",
    "build:codex-relay": "node scripts/build-codex-relay.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:unit": "vitest run test/remote",
    "diagnose:agents": "node scripts/agent-session-scan.mjs",
    "arch:graph": "node scripts/architecture-graph.mjs",
    "rebuild": "node scripts/patch-node-pty.mjs && node scripts/patch-smart-whisper.mjs && electron-rebuild -f -w node-pty,smart-whisper && node scripts/stage-conpty-dll.mjs",
    "server:build": "esbuild src/server/main.ts --bundle --platform=node --format=cjs --outfile=out/server/main.cjs --external:node-pty --external:ws --external:smart-whisper --external:ssh2 --tsconfig=tsconfig.node.json",
    "host:build": "esbuild src/session-host/host.ts --bundle --platform=node --format=cjs --outfile=out/session-host/host.cjs --external:node-pty --tsconfig=tsconfig.node.json",
    "server:start": "node out/server/main.cjs",
    "fake:dis-invoice": "esbuild scripts/dis-invoice-fake.ts --bundle --platform=node --format=cjs --outfile=out/dis-invoice-fake.cjs --log-level=warning && node out/dis-invoice-fake.cjs",
    "server:dis-invoice-proof": "esbuild scripts/dis-invoice-server.ts --bundle --platform=node --format=cjs --outfile=out/server/dis-invoice-proof.cjs --external:node-pty --external:ws --external:smart-whisper --external:ssh2 --tsconfig=tsconfig.node.json --log-level=warning && node out/server/dis-invoice-proof.cjs",
    "server:dev": "npm run build && npm run server:build && node out/server/main.cjs",
    "make-icon": "node scripts/make-icon.mjs",
    "make-social": "node scripts/make-social.mjs",
    "dist": "npm run make-icon && npm run build && electron-builder --mac --arm64 --publish never -c.mac.identity=null -c.mac.notarize=false",
    "dist:mac:x64": "npm run make-icon && npm run build && sh -c 'electron-builder --mac --x64 --publish never -c.mac.identity=null -c.mac.notarize=false; s=$?; npm run rebuild; r=$?; if [ $s -ne 0 ]; then exit $s; fi; exit $r'",
    "dist:linux": "npm run make-icon && npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run make-icon && npm run build && electron-builder --win --x64 --publish never",
    "release": "node scripts/release.mjs",
    "release:mac": "npm run make-icon && npm run build && sh -c 'electron-builder --mac --arm64 --x64 --publish never; s=$?; npm run rebuild; r=$?; [ \"$s\" -eq 0 ] || exit \"$s\"; [ \"$r\" -eq 0 ] && exit 0; echo \"release: the build is good, but restoring native modules failed; run npm run rebuild\" >&2; [ -n \"$CI\" ] && exit 0; exit \"$r\"'",
    "postinstall": "node scripts/patch-node-pty.mjs && node scripts/patch-smart-whisper.mjs && electron-rebuild -f -w node-pty,smart-whisper && node scripts/stage-conpty-dll.mjs"
  },
  "build": {
    "appId": "com.distriib.disterm",
    "productName": "DisTerm",
    "copyright": "(c) 2026 Enes Kirca. DisTerm modifications by Distriib.",
    "protocols": [
      {
        "name": "nodeterm",
        "schemes": [
          "nodeterm"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/smart-whisper/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Distriib <support@distriib.com>"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extraResources": [
        {
          "from": "resources/bin/tmux",
          "to": "bin/tmux"
        },
        {
          "from": "resources/licenses",
          "to": "licenses"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "DisTerm uses the microphone so you can dictate into your terminals.",
        "NSLocalNetworkUsageDescription": "Terminals and agents you run may connect to devices and servers on your local network."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "out/session-host",
          "to": "session-host",
          "filter": [
            "host.cjs"
          ]
        },
        {
          "from": "node_modules/node-pty",
          "to": "session-host/node_modules/node-pty",
          "filter": [
            "package.json",
            "lib/**/*.js",
            "!lib/**/*.test.js",
            "build/Release/*.node",
            "build/Release/*.exe",
            "build/Release/*.dll",
            "build/Release/conpty/conpty.dll",
            "build/Release/conpty/OpenConsole.exe"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "publish": null
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "emoji-picker-react": "^4.22.2",
    "lucide-react": "^1.62.0",
    "marked": "^12.0.2",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "smart-whisper": "^0.8.1",
    "ssh2": "^1.17.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@electron/rebuild": "^4.2.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.12.0",
    "3d-force-graph": "1.80.1",
    "css-tree": "^3.2.1",
    "d3-force-3d": "3.0.6",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.1",
    "three": "0.186.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.14"
    },
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "sass": "1.105.2",
      "lodash-es": "4.18.1",
      "katex": "0.19.0",
      "mermaid": "12.2.0",
      "@mermaid-js/parser": "2.0.1",
      "@excalidraw/mermaid-to-excalidraw": {
        "nanoid": "5.1.16"
      }
    },
    "3d-force-graph": {
      "float-tooltip": "1.7.5"
    }
  }
}
